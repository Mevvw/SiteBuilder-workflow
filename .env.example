# ===== workflow_chain 运行配置示例 =====
# mock / cloud 档不需要本文件任何 Key。
# OpenAI 兼容厂商预设:用哪个厂商就填哪个 Key(用法见 README「模型接入」)。

# DeepSeek 官方(https://platform.deepseek.com)→ --provider deepseek(默认模型 deepseek-chat)
DEEPSEEK_API_KEY=

# 智谱 GLM(https://open.bigmodel.cn)→ --provider glm --model glm-5.3
ZHIPU_API_KEY=

# Kimi / Moonshot(https://platform.moonshot.cn)→ --provider kimi --model moonshot-v1-8k
MOONSHOT_API_KEY=

# 通义千问(https://dashscope.console.aliyun.com)→ --provider qwen --model qwen-plus
DASHSCOPE_API_KEY=

# OpenAI(https://platform.openai.com)→ --provider openai --model gpt-4o
OPENAI_API_KEY=

# ===== 任意其他 OpenAI 兼容端点(SiliconFlow / 火山方舟 / 自建网关等)=====
# 两项都填后 --provider 写任意名字即可,如 --provider siliconflow --model Qwen/Qwen3-32B
LLM_BASE_URL=
LLM_API_KEY=

# 可选:覆盖默认模型名(优先级高于各档默认)
WORKFLOW_MODEL=
